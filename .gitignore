# Raw captures and lecture material — large binaries, consumed once, never committed
courses/*/raw/
courses/*/slides/

# Leftover unsorted tree at the repo root — the 30 flagged files awaiting a keep/drop
# decision. Anchored with a leading slash so it matches only ./microbiology/, not
# courses/microbiology/ — unanchored it silently swallowed the whole course (source.md
# and friends were never tracked as a result). Remove this line once the folder is
# resolved and deleted.
/microbiology/

# Local Stage 0 work product — regenerated from raw at any time
courses/*/.prep/

# Site build output
site/dist/
site/node_modules/

# Generated PDFs anywhere outside course output
*.pdf
!courses/*/out/*.pdf

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
